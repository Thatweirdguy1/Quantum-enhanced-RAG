# Q-RAG environment template.
#
#   cp .env.example .env      then edit .env, which is gitignored.
#
# Every value below is read through qrag.config or qrag.security. There are no
# credentials hardcoded anywhere in the source tree; scripts/security_audit.py
# fails the build if any appear. If you ever paste a real key into a file that
# git tracks, treat it as leaked: rotate it at the provider, then remove it from
# history (git filter-repo / BFG) -- deleting the line in a new commit does NOT
# remove it, because the old blob is still reachable.

# ---------------------------------------------------------------- retrieval stack
# Embedding backend: ollama | sbert | hashing
# "hashing" needs no network and no weights; it exists so the test suite runs
# anywhere, and is never used for reported numbers.
QRAG_EMBED_BACKEND=ollama
QRAG_EMBED_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------- generation stack
# The judge must be a different model family from the generator, otherwise the
# evaluation rewards self-similarity rather than answer quality.
QRAG_GEN_MODEL=qwen3.5:latest
QRAG_JUDGE_MODEL=deepseek-r1:8b

# ------------------------------------------------------------------ log hygiene
# Salt for the query fingerprints in logs. Logs record fingerprint(query), never
# the query itself, so a log file cannot be mined for what users asked. Change
# this and old fingerprints stop correlating -- that is intended: the salt is what
# stops an attacker pre-computing digests of common queries.
QRAG_LOG_SALT=change-me-to-any-random-string

# ------------------------------------------------------------- resource ceilings
# Enforced by qrag.security. A statevector is 2**n complex128, so an unvalidated
# qubit count is a one-line memory exhaustion; these are the refusal points.
QRAG_MAX_QUBITS=22
QRAG_MAX_EXACT_QUBITS=20
QRAG_MAX_QUERY_CHARS=2000
QRAG_MAX_PASSAGE_CHARS=8000
QRAG_MAX_TOP_K=100
QRAG_MAX_CONTEXT_DOCS=10
QRAG_MAX_CORPUS_DOCS=500000

# ------------------------------------------------------------------ demo API only
# Used by qrag.serve. Required with no default when QRAG_ENV=production, so a
# misconfigured deployment refuses to start instead of silently running open.
QRAG_ENV=development
QRAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QRAG_RATE_LIMIT_PER_MIN=20
QRAG_API_TOKEN=
